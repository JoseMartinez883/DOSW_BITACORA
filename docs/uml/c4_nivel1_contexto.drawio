        <mxCell id="system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=13;arcSize=10;shadow=1;" value="&lt;b&gt;TECH CUP FÚTBOL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de Software]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Plataforma web centralizada para la gestión integral del torneo: registro, equipos, torneos, arbitraje en vivo y estadísticas." vertex="1">
